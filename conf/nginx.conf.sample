load_module modules/ngx_http_naxsi_module.so;

user  nginx;
worker_processes auto;

events { worker_connections 1024; }

http {
  include       mime.types;
  default_type  application/octet-stream;
  sendfile      on;

  upstream upstream_app {
    server 127.0.0.1:8080;
  }

  # Core definitions & blocking MainRule sets (http context)
  include /etc/nginx/naxsi/naxsi_core.rules;
  include /etc/nginx/naxsi/blocking/*.rules;

  server {
    listen 80 default_server;

    location / {
      SecRulesEnabled;
      LearningMode;         # remove once tuned to enforce blocking
      DeniedUrl "/RequestDenied";

      # CheckRule thresholds & whitelists (location context)
      include /etc/nginx/naxsi/app.rules;

      proxy_pass http://upstream_app;
    }

    location = /RequestDenied { return 403; }
    location /healthz { return 200 "ok\n"; add_header Content-Type text/plain; }
  }
}